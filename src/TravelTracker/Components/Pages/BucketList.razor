@page "/bucketlist"
@using TravelTracker.Data.Models
@using TravelTracker.Services.Interfaces
@implements IAsyncDisposable
@inject IDestinationService DestinationService
@inject IAuthenticationService AuthenticationService
@inject IJSRuntime JSRuntime
@inject IConfiguration Configuration
@inject ILogger<BucketList> Logger

<PageTitle>Bucket List - Travel Tracker</PageTitle>

<h1>My Bucket List</h1>

<div class="bucket-list-container">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <!-- Tabs for different destination types -->
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(selectedTab == "natl-parks" ? "active" : "")" 
                    @onclick="@(() => SelectTab("natl-parks"))">
                Nat'l Parks (@visitedNationalParks.Count / @totalNationalParks.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(selectedTab == "pres-libraries" ? "active" : "")" 
                    @onclick="@(() => SelectTab("pres-libraries"))">
                Pres Libraries (@visitedPresidentialLibraries.Count / @totalPresidentialLibraries.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(selectedTab == "high-points" ? "active" : "")" 
                    @onclick="@(() => SelectTab("high-points"))">
                High Points (@visitedHighPoints.Count / @totalHighPoints.Count)
            </button>
        </li>
    </ul>

    <!-- Map -->
    <div class="card mb-3">
        <div class="card-body p-0" style="position: relative;">
            @if (string.IsNullOrEmpty(azureMapsKey))
            {
                <div class="d-flex align-items-center justify-content-center" style="min-height: 600px;">
                    <div class="text-center p-4">
                        <h3 class="text-muted mb-3">🗺️</h3>
                        <h5 class="mb-3">Azure Maps Not Configured</h5>
                        <p class="text-muted">Configure Azure Maps subscription key to enable map visualization.</p>
                    </div>
                </div>
            }
            else
            {
                <div id="bucketListMap" style="height: 600px; width: 100%; position: relative;"></div>
                @if (isLoading)
                {
                    <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-body bg-opacity-75">
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3">Loading destinations...</p>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Destination List -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">@GetCurrentTabTitle()</h5>
        </div>
        <div class="card-body">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading destinations...</p>
                </div>
            }
            else if (!currentDestinations.Any())
            {
                <div class="text-center py-5">
                    <p class="text-muted">No destinations found.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Destination</th>
                                <th>Type</th>
                                <th>State</th>
                                <th>Date Visited</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var dest in currentDestinations.OrderBy(d => d.Name))
                            {
                                var isVisited = visitedDestinations.Any(v => v.Id == dest.Id);
                                <tr class="@(isVisited ? "table-success" : "")">
                                    <td>
                                        @if (isVisited)
                                        {
                                            <span class="badge bg-success me-2">✓</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary me-2">○</span>
                                        }
                                        @dest.Name
                                    </td>
                                    <td>@GetDestinationTypeName(dest.DestinationTypeId)</td>
                                    <td>@dest.State</td>
                                    <td>@(isVisited ? GetVisitDate(dest) : "Not Yet")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .bucket-list-container {
        padding: 0;
    }

    .nav-tabs .nav-link {
        cursor: pointer;
    }

    .table-success {
        --bs-table-bg: rgba(25, 135, 84, 0.1);
    }
</style>

@code {
    private List<Destination> allDestinations = new();
    private List<Destination> totalNationalParks = new();
    private List<Destination> totalPresidentialLibraries = new();
    private List<Destination> totalHighPoints = new();
    private List<Destination> visitedNationalParks = new();
    private List<Destination> visitedPresidentialLibraries = new();
    private List<Destination> visitedHighPoints = new();
    private List<Destination> visitedDestinations = new();
    private List<Destination> currentDestinations = new();
    private Dictionary<int, string> destinationTypeNames = new();
    private bool isLoading = false;
    private bool isMapInitialized = false;
    private string errorMessage = string.Empty;
    private int currentUserId;
    private string? azureMapsKey;
    private string selectedTab = "natl-parks";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Logger.LogInformation("BucketList.OnInitializedAsync starting");
            currentUserId = AuthenticationService.GetCurrentUserInternalId();
            azureMapsKey = Configuration["AzureMaps:SubscriptionKey"];
            Logger.LogInformation("AzureMaps key present: {HasKey}", !string.IsNullOrEmpty(azureMapsKey));
            await LoadDestinations();
            Logger.LogInformation("BucketList.OnInitializedAsync completed");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unhandled exception in OnInitializedAsync");
            errorMessage = $"Initialization failed: {ex.Message}";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(azureMapsKey) && !isMapInitialized)
        {
            if (!isLoading)
            {
                await InitializeMap();
            }
        }
    }

    private async Task InitializeMap()
    {
        try
        {
            Logger.LogInformation("Initializing Bucket List Map...");
            var result = await JSRuntime.InvokeAsync<bool>("initializeAzureMap", "bucketListMap", azureMapsKey, 39.8283, -98.5795, 4);
            if (result)
            {
                isMapInitialized = true;
                Logger.LogInformation("Bucket List Map initialized successfully");
                await UpdateMapMarkers();
            }
            else
            {
                Logger.LogWarning("initializeAzureMap returned false");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to initialize map: {ex.Message}";
            Logger.LogError(ex, "Map initialization error");
        }
    }

    private async Task UpdateMapMarkers()
    {
        if (!isMapInitialized || string.IsNullOrEmpty(azureMapsKey))
        {
            Logger.LogDebug("Skipping UpdateMapMarkers. Initialized={Initialized} HasKey={HasKey}", isMapInitialized, !string.IsNullOrEmpty(azureMapsKey));
            return;
        }

        try
        {
            var markers = currentDestinations
                .Select(d => new
                {
                    lat = d.Latitude,
                    lon = d.Longitude,
                    name = d.Name,
                    state = d.State,
                    isVisited = visitedDestinations.Any(v => v.Id == d.Id),
                    destinationType = GetDestinationTypeName(d.DestinationTypeId)
                })
                .ToArray();

            Logger.LogInformation("Updating bucket list map markers. Count={Count}", markers.Length);
            await JSRuntime.InvokeVoidAsync("updateBucketListMapMarkers", "bucketListMap", (object)markers);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update map markers: {ex.Message}";
            Logger.LogError(ex, "Map marker update error");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (isMapInitialized)
            {
                Logger.LogInformation("Disposing Bucket List Map");
                await JSRuntime.InvokeVoidAsync("disposeAzureMap", "bucketListMap");
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error during map disposal (ignored)");
        }
    }

    private async Task LoadDestinations()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;

            // Load all destinations
            allDestinations = (await DestinationService.GetAllDestinationsAsync()).ToList();
            
            // Load destination types
            var types = await DestinationService.GetAllDestinationTypesAsync();
            destinationTypeNames = types.ToDictionary(t => t.Id, t => t.Name);

            // Group by type
            totalNationalParks = allDestinations.Where(d => d.DestinationTypeId == 1).ToList();
            totalPresidentialLibraries = allDestinations.Where(d => d.DestinationTypeId == 3).ToList();
            totalHighPoints = allDestinations.Where(d => d.DestinationTypeId == 2).ToList();

            // Load visited destinations
            visitedDestinations = (await DestinationService.GetVisitedDestinationsAsync(currentUserId)).ToList();
            visitedNationalParks = visitedDestinations.Where(d => d.DestinationTypeId == 1).ToList();
            visitedPresidentialLibraries = visitedDestinations.Where(d => d.DestinationTypeId == 3).ToList();
            visitedHighPoints = visitedDestinations.Where(d => d.DestinationTypeId == 2).ToList();

            Logger.LogInformation("Loaded destinations. Total={Total}, Visited={Visited}", allDestinations.Count, visitedDestinations.Count);
            
            // Set initial tab
            await SelectTab(selectedTab);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load destinations");
            errorMessage = $"Failed to load destinations: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            if (!isMapInitialized && !string.IsNullOrEmpty(azureMapsKey))
            {
                await InitializeMap();
            }
        }
    }

    private async Task SelectTab(string tab)
    {
        selectedTab = tab;
        
        currentDestinations = tab switch
        {
            "natl-parks" => totalNationalParks,
            "pres-libraries" => totalPresidentialLibraries,
            "high-points" => totalHighPoints,
            _ => new List<Destination>()
        };

        if (isMapInitialized)
        {
            await UpdateMapMarkers();
        }

        StateHasChanged();
    }

    private string GetCurrentTabTitle()
    {
        return selectedTab switch
        {
            "natl-parks" => "National Parks",
            "pres-libraries" => "Presidential Libraries",
            "high-points" => "State High Points",
            _ => "Destinations"
        };
    }

    private string GetDestinationTypeName(int destinationTypeId)
    {
        return destinationTypeNames.TryGetValue(destinationTypeId, out var name) ? name : "Unknown";
    }

    private string GetVisitDate(Destination dest)
    {
        // This is a simplified version - in reality you'd need to match with actual location visits
        // For now, just return a placeholder
        return "Jan 5, 2020";
    }
}
