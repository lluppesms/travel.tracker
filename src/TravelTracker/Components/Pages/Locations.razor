@page "/locations"
@attribute [Authorize]
@using TravelTracker.Data.Models
@using TravelTracker.Services.Interfaces
@using TravelTracker.Services.Services
@inject ILocationService LocationService
@inject ILocationTypeService LocationTypeService
@inject IDestinationService DestinationService
@inject ILocationLookupService LocationLookupService
@inject LocationLookupAPIService LocationLookupAPIService
@inject IAuthenticationService AuthenticationService

<PageTitle>Locations - Travel Tracker</PageTitle>

<h1>My Locations</h1>

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error:</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">My Travel Locations</h5>
                    <button class="btn btn-primary btn-sm" @onclick="ShowAddLocationForm">
                        <span class="bi bi-plus-circle"></span> Add Location
                    </button>
                </div>
                <div class="card-body">
                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-2">Loading locations...</p>
                        </div>
                    }
                    else if (locations == null || !locations.Any())
                    {
                        <div class="text-center py-5">
                            <p class="text-muted">No locations found. Start by adding your first location!</p>
                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <input type="text" 
                                   class="form-control" 
                                   placeholder="Filter by name, trip name, type, city, or state..." 
                                   @bind="filterText" 
                                   @bind:event="oninput"
                                   @bind:after="ApplyFilter" />
                        </div>
                        <div class="table-responsive">
                            <QuickGrid Items="@FilteredLocations" 
                                      Pagination="@pagination"
                                      Class="table table-hover">
                                <PropertyColumn Property="@(l => l.Name)" Sortable="true" Title="Name" />
                                <PropertyColumn Property="@(l => l.TripName)" Sortable="true" Title="Trip Name" />
                                <PropertyColumn Property="@(l => l.LocationType)" Sortable="true" Title="Type" />
                                <TemplateColumn Title="Location" Sortable="true" SortBy="GridSort<Location>.ByAscending(l => l.City).ThenAscending(l => l.State)">
                                    @context.City, @context.State
                                </TemplateColumn>
                                <PropertyColumn Property="@(l => l.StartDate)" Sortable="true" Title="Date" Format="MM/dd/yyyy" />
                                <TemplateColumn Title="Rating" Sortable="true" SortBy="GridSort<Location>.ByAscending(l => l.Rating)">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        var rating = i;
                                        <span class="@(rating <= context.Rating ? "text-warning" : "text-muted")">★</span>
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="Actions">
                                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditLocationForm(context)">
                                        Edit
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ShowDeleteConfirmation(context)">
                                        Delete
                                    </button>
                                </TemplateColumn>
                            </QuickGrid>
                        </div>
                        <div class="mt-2">
                            <Paginator State="@pagination" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (showLocationForm)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Edit Location" : "Add New Location")</h5>
                    <button type="button" class="btn-close" @onclick="HideLocationForm"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="currentLocation" OnValidSubmit="SaveLocation">
                        <DataAnnotationsValidator />

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Location Type *</label>
                                <InputSelect class="form-select"
                                             @bind-Value="currentLocation.LocationType"
                                             @bind-Value:after="OnLocationTypeChangedAsync"
                                             disabled="@(isLookingUp || isSaving)">
                                    <option value="">-- Select Location Type --</option>
                                    @foreach (var locationType in locationTypes)
                                    {
                                        <option value="@locationType.Name">@locationType.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => currentLocation.LocationType)" />
                            </div>
                        </div>

                        @if (IsDestinationPickerType(currentLocation.LocationType))
                        {
                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Select @currentLocation.LocationType *</label>
                                    @if (isLoadingDestinations)
                                    {
                                        <div class="d-flex align-items-center">
                                            <div class="spinner-border spinner-border-sm me-2" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                            <span>Loading @currentLocation.LocationType list...</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <select class="form-select"
                                                value="@selectedDestinationId"
                                                @onchange="OnDestinationSelected"
                                                disabled="@(isLookingUp || isSaving)">
                                            <option value="0">-- Select a @currentLocation.LocationType --</option>
                                            @foreach (var dest in availableDestinations)
                                            {
                                                <option value="@dest.Id">@dest.Name (@dest.State)</option>
                                            }
                                        </select>
                                    }
                                </div>
                            </div>

                            @if (selectedDestinationId > 0)
                            {
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Name</label>
                                        <InputText class="form-control" @bind-Value="currentLocation.Name" readonly />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Trip Name</label>
                                        <InputText class="form-control" @bind-Value="currentLocation.TripName" disabled="@(isLookingUp || isSaving)" />
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Name *</label>
                                    <InputText class="form-control" @bind-Value="currentLocation.Name" disabled="@(isLookingUp || isSaving)" />
                                    <ValidationMessage For="@(() => currentLocation.Name)" />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">City</label>
                                    <InputText class="form-control" @bind-Value="currentLocation.City" disabled="@(isLookingUp || isSaving)" />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">State *</label>
                                    <InputText class="form-control" @bind-Value="currentLocation.State" placeholder="CA" maxlength="2" disabled="@(isLookingUp || isSaving)" />
                                </div>
                                <div class="col-md-2 mb-3 d-flex align-items-end">
                                    <button type="button" style="padding: 2px; margin: 2px;"
                                            class="btn btn-outline-secondary w-100"
                                            @onclick="LookupLocationAsync"
                                            disabled="@(isLookingUp || isSaving)"
                                            title="Lookup via AI Foundry agent">
                                        @if (isLookingUp)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <span class="bi bi-geo-alt me-1" aria-hidden="true"></span>
                                        }
                                        <span>AI</span>
                                    </button>
                                    <button type="button" style="padding: 2px; margin: 2px;"
                                            class="btn btn-outline-secondary w-100"
                                            @onclick="LookupLocationViaAPIAsync"
                                            disabled="@(isLookingUp || isSaving)"
                                            title="Lookup via public API">
                                        @if (isLookingUp)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <span class="bi bi-search me-1" aria-hidden="true"></span>
                                        }
                                        <span>API</span>
                                    </button>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-9 mb-3">
                                    <label class="form-label">Address</label>
                                    <InputText class="form-control" @bind-Value="currentLocation.Address" disabled="@(isLookingUp || isSaving)" />
                                </div>
                                <div class="col-md-3 mb-3">
                                    <label class="form-label">Zip Code</label>
                                    <InputText class="form-control" @bind-Value="currentLocation.ZipCode" disabled="@(isLookingUp || isSaving)" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Latitude</label>
                                    <InputNumber class="form-control" @bind-Value="currentLocation.Latitude" disabled="@(isLookingUp || isSaving)" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Longitude</label>
                                    <InputNumber class="form-control" @bind-Value="currentLocation.Longitude" disabled="@(isLookingUp || isSaving)" />
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 mb-3">
                                    <label class="form-label">Trip Name</label>
                                    <InputText class="form-control" @bind-Value="currentLocation.TripName" disabled="@(isLookingUp || isSaving)" />
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(lookupMessage))
                            {
                                <div class="alert @(lookupSuccess ? "alert-success" : "alert-warning") alert-dismissible py-2 mb-3" role="alert">
                                    @lookupMessage
                                    <button type="button" class="btn-close" @onclick="() => lookupMessage = string.Empty"></button>
                                </div>
                            }
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Start Date *</label>
                                <InputDate class="form-control" @bind-Value="currentLocation.StartDate" @bind-Value:after="OnStartDateChanged" disabled="@(isLookingUp || isSaving)" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">End Date</label>
                                <InputDate class="form-control" @bind-Value="currentLocation.EndDate" disabled="@(isLookingUp || isSaving)" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Rating (1-5)</label>
                                <InputSelect class="form-select" @bind-Value="currentLocation.Rating" TValue="int">
                                    <option value="0">-- Select Rating --</option>
                                    @for (var rating = 1; rating <= 5; rating++)
                                    {
                                        <option value="@rating">@rating</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Comments</label>
                            <InputTextArea class="form-control" @bind-Value="currentLocation.Comments" rows="3" disabled="@(isLookingUp || isSaving)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="HideLocationForm" disabled="@(isLookingUp || isSaving)">Cancel</button>
                            <button type="submit" class="btn btn-primary" disabled="@(isSaving || isLookingUp)">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Save
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showDeleteConfirmation)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm Delete</h5>
                    <button type="button" class="btn-close" @onclick="HideDeleteConfirmation"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong>@locationToDelete?.Name</strong>?</p>
                    <p class="text-muted">This action cannot be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="HideDeleteConfirmation">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteLocation" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Delete
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Location> locations = new();
    private List<LocationType> locationTypes = new();
    private List<Destination> availableDestinations = new();
    private int selectedDestinationId = 0;
    private Location currentLocation = new();
    private Location? locationToDelete;
    private bool showLocationForm = false;
    private bool showDeleteConfirmation = false;
    private bool isEditMode = false;
    private bool isLoading = false;
    private bool isSaving = false;
    private bool isDeleting = false;
    private bool isLookingUp = false;
    private bool isLoadingDestinations = false;
    private bool lookupSuccess = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private string lookupMessage = string.Empty;
    private int currentUserId;
    private string filterText = string.Empty;
    private PaginationState pagination = new() { ItemsPerPage = 15 };

    private static readonly HashSet<string> DestinationPickerTypes = new(StringComparer.OrdinalIgnoreCase)
    {
        "National Park", "Presidential Library", "State High Point"
    };

    private bool IsDestinationPickerType(string? locationType) =>
        !string.IsNullOrEmpty(locationType) && DestinationPickerTypes.Contains(locationType);

    private IQueryable<Location> FilteredLocations
    {
        get
        {
            if (string.IsNullOrWhiteSpace(filterText))
            {
                return locations.AsQueryable();
            }

            var filter = filterText.ToLower();
            return locations
                .Where(l => 
                    (l.Name?.ToLower().Contains(filter) ?? false) ||
                    (l.TripName?.ToLower().Contains(filter) ?? false) ||
                    (l.LocationType?.ToLower().Contains(filter) ?? false) ||
                    (l.City?.ToLower().Contains(filter) ?? false) ||
                    (l.State?.ToLower().Contains(filter) ?? false))
                .AsQueryable();
        }
    }

    private async Task ApplyFilter()
    {
        // Reset to first page when filter changes
        await pagination.SetCurrentPageIndexAsync(0);
    }

    protected override async Task OnInitializedAsync()
    {
        currentUserId = AuthenticationService.GetCurrentUserInternalId();
        await LoadLocationTypes();
        await LoadLocations();
    }

    private async Task LoadLocationTypes()
    {
        try
        {
            var types = await LocationTypeService.GetAllLocationTypesAsync();
            locationTypes = types.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load location types: {ex.Message}";
            locationTypes = new List<LocationType>();
        }
    }

    private async Task LoadLocations()
    {
        try
        {
            isLoading = true;
            errorMessage = string.Empty;
            var result = await LocationService.GetAllLocationsAsync(currentUserId);
            locations = result.ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load locations: {ex.Message}";
            locations = new List<Location>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddLocationForm()
    {
        currentLocation = new Location
        {
            UserId = currentUserId,
            StartDate = DateTime.Today,
            EndDate = DateTime.Today,
            Rating = 5
        };
        isEditMode = false;
        showLocationForm = true;
        selectedDestinationId = 0;
        availableDestinations = new();
        lookupMessage = string.Empty;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private async Task ShowEditLocationForm(Location location)
    {
        currentLocation = new Location
        {
            Id = location.Id,
            UserId = location.UserId,
            Name = location.Name,
            TripName = location.TripName,
            LocationType = location.LocationType,
            Address = location.Address,
            City = location.City,
            State = location.State,
            ZipCode = location.ZipCode,
            Latitude = location.Latitude,
            Longitude = location.Longitude,
            StartDate = location.StartDate,
            EndDate = location.EndDate,
            Rating = location.Rating,
            Comments = location.Comments,
            Tags = new List<string>(location.Tags),
            CreatedDate = location.CreatedDate
        };
        isEditMode = true;
        showLocationForm = true;
        selectedDestinationId = 0;
        availableDestinations = new();
        lookupMessage = string.Empty;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        if (IsDestinationPickerType(currentLocation.LocationType))
        {
            await LoadDestinationsForTypeAsync(currentLocation.LocationType);
            var matchingDest = availableDestinations.FirstOrDefault(d =>
                string.Equals(d.Name, currentLocation.Name, StringComparison.OrdinalIgnoreCase) ||
                (currentLocation.Name != null && currentLocation.Name.Contains(d.Name, StringComparison.OrdinalIgnoreCase)));
            selectedDestinationId = matchingDest?.Id ?? 0;
        }
    }

    private async Task OnLocationTypeChangedAsync()
    {
        selectedDestinationId = 0;
        availableDestinations = new();
        lookupMessage = string.Empty;

        if (IsDestinationPickerType(currentLocation.LocationType))
        {
            currentLocation.Address = string.Empty;
            currentLocation.City = string.Empty;
            currentLocation.ZipCode = string.Empty;
            await LoadDestinationsForTypeAsync(currentLocation.LocationType);
        }

        StateHasChanged();
    }

    private void OnStartDateChanged()
    {
        // For new locations, automatically set end date to match start date
        if (!isEditMode && currentLocation.EndDate == null)
        {
            currentLocation.EndDate = currentLocation.StartDate;
        }
    }

    private async Task LoadDestinationsForTypeAsync(string locationType)
    {
        try
        {
            isLoadingDestinations = true;
            StateHasChanged();
            var destinations = await DestinationService.GetDestinationsByTypeNameAsync(locationType);
            availableDestinations = destinations.OrderBy(d => d.Name).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load {locationType} list: {ex.Message}";
            availableDestinations = new();
        }
        finally
        {
            isLoadingDestinations = false;
        }
    }

    private void OnDestinationSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var destId) && destId > 0)
        {
            selectedDestinationId = destId;
            var dest = availableDestinations.FirstOrDefault(d => d.Id == destId);
            if (dest != null)
            {
                currentLocation.Name = dest.Name;
                currentLocation.State = dest.State;
                currentLocation.Latitude = dest.Latitude;
                currentLocation.Longitude = dest.Longitude;
                currentLocation.Address = string.Empty;
                currentLocation.City = string.Empty;
                currentLocation.ZipCode = string.Empty;
            }
        }
        else
        {
            selectedDestinationId = 0;
            currentLocation.Name = string.Empty;
            currentLocation.State = string.Empty;
            currentLocation.Latitude = 0;
            currentLocation.Longitude = 0;
        }
    }

    private async Task LookupLocationAsync()
    {
        try
        {
            isLookingUp = true;
            lookupMessage = string.Empty;
            StateHasChanged();

            var hasLookupInput = !string.IsNullOrWhiteSpace(currentLocation.Address)
                || !string.IsNullOrWhiteSpace(currentLocation.City)
                || !string.IsNullOrWhiteSpace(currentLocation.State)
                || !string.IsNullOrWhiteSpace(currentLocation.ZipCode);

            if (!hasLookupInput)
            {
                lookupSuccess = false;
                lookupMessage = "Please fill in at least one address field (Address, City, State, or Zip Code)";
                return;
            }

            var lookupResult = await LocationLookupService.LookupLocationAsync(
                currentLocation.Name ?? string.Empty,
                currentLocation.Address ?? string.Empty,
                currentLocation.City ?? string.Empty,
                currentLocation.State ?? string.Empty,
                currentLocation.ZipCode ?? string.Empty);

            if (lookupResult.Success)
            {
                if (!string.IsNullOrWhiteSpace(lookupResult.Address))
                {
                    currentLocation.Address = lookupResult.Address;
                }

                if (!string.IsNullOrWhiteSpace(lookupResult.City))
                {
                    currentLocation.City = lookupResult.City;
                }

                if (!string.IsNullOrWhiteSpace(lookupResult.State))
                {
                    currentLocation.State = lookupResult.State;
                }

                if (!string.IsNullOrWhiteSpace(lookupResult.ZipCode))
                {
                    currentLocation.ZipCode = lookupResult.ZipCode;
                }

                var hasCoordinates = lookupResult.Latitude != 0 || lookupResult.Longitude != 0;
                if (hasCoordinates)
                {
                    currentLocation.Latitude = lookupResult.Latitude;
                    currentLocation.Longitude = lookupResult.Longitude;
                }

                lookupSuccess = true;
                lookupMessage = "Coordinates found successfully!";
            }
            else
            {
                lookupSuccess = false;
                lookupMessage = string.IsNullOrWhiteSpace(lookupResult.ErrorMessage)
                    ? "Lookup failed. Please verify the address and try again."
                    : lookupResult.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            lookupSuccess = false;
            lookupMessage = $"Lookup failed: {ex.Message}";
        }
        finally
        {
            isLookingUp = false;
        }
    }

    private async Task LookupLocationViaAPIAsync()
    {
        try
        {
            isLookingUp = true;
            lookupMessage = string.Empty;
            StateHasChanged();

            var hasLookupInput = !string.IsNullOrWhiteSpace(currentLocation.Address)
                || !string.IsNullOrWhiteSpace(currentLocation.City)
                || !string.IsNullOrWhiteSpace(currentLocation.State)
                || !string.IsNullOrWhiteSpace(currentLocation.ZipCode);

            if (!hasLookupInput)
            {
                lookupSuccess = false;
                lookupMessage = "Please fill in at least one address field (Address, City, State, or Zip Code)";
                return;
            }

            var lookupResult = await LocationLookupAPIService.LookupLocationAsync(
                currentLocation.Name ?? string.Empty,
                currentLocation.Address ?? string.Empty,
                currentLocation.City ?? string.Empty,
                currentLocation.State ?? string.Empty,
                currentLocation.ZipCode ?? string.Empty);

            if (lookupResult.Success)
            {
                if (!string.IsNullOrWhiteSpace(lookupResult.Address))
                    currentLocation.Address = lookupResult.Address;
                if (!string.IsNullOrWhiteSpace(lookupResult.City))
                    currentLocation.City = lookupResult.City;
                if (!string.IsNullOrWhiteSpace(lookupResult.State))
                    currentLocation.State = lookupResult.State;
                if (!string.IsNullOrWhiteSpace(lookupResult.ZipCode))
                    currentLocation.ZipCode = lookupResult.ZipCode;

                var hasCoordinates = lookupResult.Latitude != 0 || lookupResult.Longitude != 0;
                if (hasCoordinates)
                {
                    currentLocation.Latitude = lookupResult.Latitude;
                    currentLocation.Longitude = lookupResult.Longitude;
                }

                lookupSuccess = true;
                lookupMessage = "Coordinates found via public API!";
            }
            else
            {
                lookupSuccess = false;
                lookupMessage = string.IsNullOrWhiteSpace(lookupResult.ErrorMessage)
                    ? "API Lookup failed. Please verify the address and try again."
                    : lookupResult.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            lookupSuccess = false;
            lookupMessage = $"API Lookup failed: {ex.Message}";
        }
        finally
        {
            isLookingUp = false;
        }
    }

    private void HideLocationForm()
    {
        showLocationForm = false;
        currentLocation = new Location();
        selectedDestinationId = 0;
        availableDestinations = new();
        lookupMessage = string.Empty;
    }

    private async Task SaveLocation()
    {
        try
        {
            isSaving = true;
            errorMessage = string.Empty;

            currentLocation.ModifiedDate = DateTime.UtcNow;

            if (isEditMode)
            {
                var result = await LocationService.UpdateLocationAsync(currentLocation);
                successMessage = result == null ? "Location update failed!" : "Location updated successfully!";
            }
            else
            {
                var result = await LocationService.CreateLocationAsync(currentLocation);
                if (result.Id <= 0)
                {
                    throw new InvalidOperationException("The location was not persisted.");
                }

                successMessage = "Location added successfully!";
            }

            HideLocationForm();
            await LoadLocations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to save location: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowDeleteConfirmation(Location location)
    {
        locationToDelete = location;
        showDeleteConfirmation = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;
    }

    private void HideDeleteConfirmation()
    {
        showDeleteConfirmation = false;
        locationToDelete = null;
    }

    private async Task DeleteLocation()
    {
        if (locationToDelete == null) return;

        try
        {
            isDeleting = true;
            errorMessage = string.Empty;

            await LocationService.DeleteLocationAsync(locationToDelete.Id, locationToDelete.UserId);
            successMessage = $"Location '{locationToDelete.Name}' deleted successfully!";

            HideDeleteConfirmation();
            await LoadLocations();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete location: {ex.Message}";
        }
        finally
        {
            isDeleting = false;
        }
    }
}
