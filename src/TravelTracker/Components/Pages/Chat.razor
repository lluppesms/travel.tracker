@page "/chat"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TravelTracker.Services
@using TravelTracker.Services.Interfaces
@using TravelTracker.Services.Models
@namespace TravelTracker.Components.Pages
@inject IChatbotService ChatbotService
@inject ICurrentTravelUserResolver CurrentUserResolver
@inject ITravelAssistantActionService ActionService
@inject ITravelAssistantActionConfirmationService ConfirmationService
@inject TravelAssistantReadiness Readiness
@inject ILogger<Chat> Logger
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Travel Assistant Chat</PageTitle>

<div class="container mt-4 chat-page">
    <div class="row">
        <div class="col-md-12">
            <h2>🤖 Travel Assistant</h2>
            <p class="text-muted">Ask me anything about your travels, locations, or national parks!</p>
        </div>
    </div>

    @if (!Readiness.IsReady)
    {
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="alert alert-warning" role="alert">
                    <strong>The travel assistant is not configured.</strong>
                    <div>Chat is unavailable until an administrator completes the setup.</div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body chat-messages" id="chatMessages" aria-live="polite">
                    @if (messages.Count == 0)
                    {
                        <div class="alert alert-info">
                            <h5>Welcome! I'm your Travel Assistant 👋</h5>
                            <p>I can help you with:</p>
                            <ul>
                                <li>Finding locations you've visited</li>
                                <li>Searching by state or date range</li>
                                <li>Getting travel statistics</li>
                                <li>Information about national parks</li>
                                <li>Available location types</li>
                            </ul>
                            <p class="mb-3"><strong>Try asking:</strong></p>
                            <div class="d-grid gap-2">
                                <button type="button" 
                                        class="btn btn-outline-primary text-start" 
                                        @onclick='() => SelectSampleQuestion("What locations have I visited in California?")'
                                        disabled="@(!Readiness.IsReady)">
                                    What locations have I visited in California?
                                </button>
                                <button type="button" 
                                        class="btn btn-outline-primary text-start" 
                                        @onclick='() => SelectSampleQuestion("How many states have I visited?")'
                                        disabled="@(!Readiness.IsReady)">
                                    How many states have I visited?
                                </button>
                                <button type="button" 
                                        class="btn btn-outline-primary text-start" 
                                        @onclick='() => SelectSampleQuestion("Tell me the top 5 states that I have been to and the first and the last time I was there.")'
                                        disabled="@(!Readiness.IsReady)">
                                    Tell me the top 5 states that I have been to and the first and the last time I was there.
                                </button>
                            </div>
                        </div>
                    }

                    @foreach (var msg in messages)
                    {
                        <div class="mb-3 @(msg.IsUser ? "text-end" : "text-start")">
                            <div class="d-inline-block p-3 rounded chat-message @(msg.IsUser ? "chat-message-user" : "chat-message-assistant")">
                                <div class="small mb-1">
                                    <strong>@(msg.IsUser ? "You" : "Assistant")</strong>
                                    <span class="text-muted ms-2">@msg.Timestamp.ToLocalTime().ToString("h:mm tt")</span>
                                </div>
                                <div class="chat-message-content">@msg.Content</div>
                                @if (msg.ToolStatuses.Count > 0)
                                {
                                    <ul class="tool-status-list mt-2 mb-0" aria-label="Assistant tool activity">
                                        @foreach (var status in msg.ToolStatuses)
                                        {
                                            <li class="tool-status tool-status-@status.State.ToString().ToLowerInvariant()">
                                                <span class="tool-status-name">@FormatToolName(status.ToolName)</span>
                                                <span>@FormatToolState(status.State)</span>
                                                @if (!string.IsNullOrWhiteSpace(status.Detail))
                                                {
                                                    <span class="tool-status-detail"> - @status.Detail</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (msg.Usage is not null)
                                {
                                    <div class="chat-usage-info mt-2" aria-label="Assistant usage diagnostics">
                                        @FormatUsage(msg.Usage)
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (isLoading)
                    {
                        <div class="text-start mb-3">
                            <div class="d-inline-block p-3 rounded loading-indicator">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <span>Assistant is thinking...</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (pendingActions.Count > 0)
    {
        <section class="row mt-3" aria-labelledby="pending-actions-heading">
            <div class="col-md-12">
                <h3 id="pending-actions-heading" class="h5">Actions awaiting your confirmation</h3>
                <div class="pending-action-list">
                    @foreach (var action in pendingActions)
                    {
                        <article class="card pending-action-card">
                            <div class="card-body">
                                <div class="pending-action-heading">
                                    <div>
                                        <h4 class="h6 mb-1">Add visited location</h4>
                                        <p class="pending-action-source mb-0">Prepared by Travel Assistant</p>
                                    </div>
                                    <span class="pending-action-state" role="status">@action.StatusLabel</span>
                                </div>
                                <p class="pending-action-summary mt-3 mb-2">@action.Action.Summary</p>
                                <p class="pending-action-expiry mb-3">
                                    Expires @FormatUtcAsLocal(action.Action.ExpiresAtUtc)
                                </p>

                                @if (action.IsPending)
                                {
                                    <div class="pending-action-controls">
                                        <button type="button"
                                                class="btn btn-primary"
                                                aria-label="Confirm adding this visited location"
                                                disabled="@action.IsExecuting"
                                                @onclick="() => ConfirmActionAsync(action)">
                                            @if (action.IsExecuting)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                            }
                                            Confirm
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-secondary"
                                                aria-label="Cancel adding this visited location"
                                                disabled="@action.IsExecuting"
                                                @onclick="() => CancelActionAsync(action)">
                                            Cancel
                                        </button>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(action.StatusMessage))
                                {
                                    <p class="pending-action-result mt-3 mb-0" role="status">
                                        @action.StatusMessage
                                        @if (action.CreatedLocationId is > 0)
                                        {
                                            <a href="/locations" class="ms-1">View locations</a>
                                        }
                                    </p>
                                }
                            </div>
                        </article>
                    }
                </div>
            </div>
        </section>
    }

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Type your message here..."
                       @bind="currentMessage"
                       @onkeypress="HandleKeyPress"
                       disabled="@(isLoading || !Readiness.IsReady)" />
                <button class="btn btn-primary"
                        @onclick="SendMessage"
                        disabled="@(isLoading || !Readiness.IsReady || string.IsNullOrWhiteSpace(currentMessage))">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <span class="bi bi-send-fill me-1"></span>
                    }
                    Send
                </button>
            </div>
            @if (!string.IsNullOrEmpty(currentThreadId))
            {
                <div class="form-text text-muted mt-1">Thread: @currentThreadId (Latest: @latestMessageDate?.ToLocalTime().ToString("MM/dd/yyyy HH:mm:ss"))</div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ChatMessage> messages = new();
    private readonly List<PendingActionViewModel> pendingActions = [];
    private string currentMessage = string.Empty;
    private bool isLoading = false;
    private string? currentThreadId = null;
    private DateTimeOffset? latestMessageDate = null;
    private TravelAssistantUserContext? currentUser;

    private class ChatMessage
    {
        public string Content { get; set; } = string.Empty;
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
        public IReadOnlyList<ToolStatus> ToolStatuses { get; set; } = [];
        public ChatUsageInfo? Usage { get; set; }
    }

    private sealed class PendingActionViewModel(AssistantActionSummary action)
    {
        public AssistantActionSummary Action { get; } = action;
        public bool IsExecuting { get; set; }
        public bool IsPending { get; set; } = true;
        public string StatusLabel { get; set; } = "Awaiting confirmation";
        public string? StatusMessage { get; set; }
        public int? CreatedLocationId { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Readiness.IsReady)
        {
            return;
        }

        currentUser = await ResolveCurrentUserAsync();
        if (currentUser is null)
        {
            return;
        }

        try
        {
            var recoveredActions = await ActionService.GetPendingActionsAsync(currentUser);
            pendingActions.AddRange(recoveredActions.Select(action => new PendingActionViewModel(action)));
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to recover pending travel assistant actions for user {UserId}.", currentUser.UserId);
        }
    }

    private async Task<ClaimsPrincipal?> GetPrincipalAsync()
    {
        if (AuthenticationStateTask is null) { return null; }
        var authenticationState = await AuthenticationStateTask;
        return authenticationState.User;
    }

    private async Task<TravelAssistantUserContext?> ResolveCurrentUserAsync()
    {
        var principal = await GetPrincipalAsync();
        return await CurrentUserResolver.ResolveAsync(principal);
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(currentMessage) && !isLoading)
        {
            await SendMessage();
        }
    }

    private async Task SelectSampleQuestion(string question)
    {
        currentMessage = question;
        StateHasChanged();
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isLoading)
            return;

        if (!Readiness.IsReady)
        {
            // Failure entries are configuration key names only; they are logged, never rendered.
            Logger.LogWarning(
                "Travel assistant is not configured; missing configuration: {MissingConfigurationKeys}",
                string.Join(", ", Readiness.Failures));
            currentMessage = string.Empty;
            messages.Add(new ChatMessage
            {
                Content = "The travel assistant is not configured.",
                IsUser = false,
                Timestamp = DateTime.UtcNow
            });
            return;
        }

        var userMessage = currentMessage.Trim();
        currentMessage = string.Empty;

        messages.Add(new ChatMessage
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.UtcNow
        });

        isLoading = true;

        // Force UI update immediately to show loading state
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1); // Small delay to ensure UI updates

        try
        {
            currentUser ??= await ResolveCurrentUserAsync();

            if (currentUser is null)
            {
                messages.Add(new ChatMessage
                {
                    Content = "You need to be signed in to use the travel assistant.",
                    IsUser = false,
                    Timestamp = DateTime.UtcNow
                });
                return;
            }

            var result = await ChatbotService.GetChatResponseAsync(
                userMessage,
                currentUser.UserId,
                currentThreadId,
                latestMessageDate);

            latestMessageDate = result.LatestMessageDate;
            currentThreadId = result.ThreadId;

            messages.Add(new ChatMessage
            {
                Content = result.Message,
                IsUser = false,
                Timestamp = result.LatestMessageDate?.UtcDateTime ?? DateTime.UtcNow,
                ToolStatuses = result.ToolStatuses,
                Usage = result.Usage
            });

            if (result.PendingAction is not null)
            {
                AddPendingAction(result.PendingAction);
            }
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to complete travel assistant chat turn.");
            messages.Add(new ChatMessage
            {
                Content = "Something went wrong processing your message. Please try again later.",
                IsUser = false,
                Timestamp = DateTime.UtcNow
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ConfirmActionAsync(PendingActionViewModel action)
    {
        if (!BeginAction(action))
        {
            return;
        }

        try
        {
            currentUser ??= await ResolveCurrentUserAsync();
            if (currentUser is null)
            {
                CompleteAction(action, false, "You need to be signed in to confirm this action.");
                return;
            }

            var result = await ConfirmationService.ConfirmActionAsync(currentUser, action.Action.ActionId);
            action.CreatedLocationId = result.CreatedLocationId;
            CompleteAction(
                action,
                result.Success,
                result.Success
                    ? result.Summary ?? "The visited location was added."
                    : result.ErrorMessage ?? "The location could not be added.",
                allowRetry: result.ErrorCode == "persistence_failed");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to confirm travel assistant action {ActionId}.", action.Action.ActionId);
            CompleteAction(action, false, "The location could not be added. Please try again.", allowRetry: true);
        }
    }

    private async Task CancelActionAsync(PendingActionViewModel action)
    {
        if (!BeginAction(action))
        {
            return;
        }

        try
        {
            currentUser ??= await ResolveCurrentUserAsync();
            if (currentUser is null)
            {
                CompleteAction(action, false, "You need to be signed in to cancel this action.");
                return;
            }

            var result = await ConfirmationService.CancelActionAsync(currentUser, action.Action.ActionId);
            CompleteAction(
                action,
                result.Success,
                result.Success
                    ? result.Summary ?? "The pending action was cancelled."
                    : result.ErrorMessage ?? "The action could not be cancelled.",
                allowRetry: result.ErrorCode == "persistence_failed");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Unable to cancel travel assistant action {ActionId}.", action.Action.ActionId);
            CompleteAction(action, false, "The action could not be cancelled. Please try again.", allowRetry: true);
        }
    }

    private static bool BeginAction(PendingActionViewModel action)
    {
        if (!action.IsPending || action.IsExecuting)
        {
            return false;
        }

        action.IsExecuting = true;
        action.StatusLabel = "Executing";
        action.StatusMessage = null;
        return true;
    }

    private static void CompleteAction(
        PendingActionViewModel action,
        bool success,
        string message,
        bool allowRetry = false)
    {
        action.IsExecuting = false;
        action.IsPending = allowRetry;
        action.StatusLabel = success ? "Complete" : "Failed";
        action.StatusMessage = message;
    }

    private void AddPendingAction(ChatActionSummary action)
    {
        if (pendingActions.Any(item => item.Action.ActionId == action.ActionId))
        {
            return;
        }

        pendingActions.Insert(
            0,
            new PendingActionViewModel(
                new AssistantActionSummary
                {
                    ActionId = action.ActionId,
                    Summary = action.Summary ?? "A visited location is ready to be added.",
                    CreatedAtUtc = DateTime.UtcNow,
                    ExpiresAtUtc = action.ExpiresAt.UtcDateTime,
                    State = "Pending"
                }));
    }

    private static string FormatToolName(string toolName) =>
        toolName.Replace('_', ' ');

    private static string FormatToolState(ToolStatusState state) =>
        state switch
        {
            ToolStatusState.Started => "started",
            ToolStatusState.Succeeded => "completed",
            ToolStatusState.Failed => "failed",
            _ => state.ToString()
        };

    private static string FormatUtcAsLocal(DateTime utcDateTime) =>
        DateTime.SpecifyKind(utcDateTime, DateTimeKind.Utc).ToLocalTime().ToString("g");

    private static string FormatUsage(ChatUsageInfo usage)
    {
        var parts = new List<string>
        {
            $"⏱ {usage.DurationSeconds:0.0}s",
            $"🔄 {usage.TurnCount} turn{(usage.TurnCount == 1 ? "" : "s")}"
        };

        if (usage.InputTokens is not null || usage.OutputTokens is not null)
        {
            parts.Add($"🔢 {usage.InputTokens ?? 0:N0} in / {usage.OutputTokens ?? 0:N0} out tokens");
        }

        if (usage.CacheReadTokens is > 0 || usage.CacheWriteTokens is > 0)
        {
            parts.Add($"💾 {usage.CacheReadTokens ?? 0:N0} cache read / {usage.CacheWriteTokens ?? 0:N0} cache write");
        }

        if (usage.TotalCost is not null)
        {
            parts.Add($"💳 {usage.TotalCost:0.####} AI Credits");
        }

        return string.Join(" · ", parts);
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", "chatMessages");
        }
        catch (Exception exception)
        {
            Logger.LogDebug(exception, "Unable to scroll the chat message list.");
        }
    }
}
