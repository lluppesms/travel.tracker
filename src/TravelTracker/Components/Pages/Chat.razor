@page "/chat"
@using System.Net.Http.Json
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Newtonsoft.Json
@using TravelTracker.Services
@using TravelTracker.Services.Interfaces
@using TravelTracker.Services.Models
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IChatbotService ChatbotService
@inject ICurrentTravelUserResolver CurrentUserResolver
@inject TravelAssistantReadiness Readiness
@inject ILogger<Chat> Logger
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Travel Assistant Chat</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <h2>🤖 Travel Assistant</h2>
            <p class="text-muted">Ask me anything about your travels, locations, or national parks!</p>
        </div>
    </div>

    @if (!Readiness.IsReady)
    {
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="alert alert-warning" role="alert">
                    <strong>The travel assistant is not configured.</strong>
                    <div>Chat is unavailable until an administrator completes the setup.</div>
                </div>
            </div>
        </div>
    }

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="card">
                <div class="card-body" style="height: 500px; overflow-y: auto;" id="chatMessages">
                    @if (messages.Count == 0)
                    {
                        <div class="alert alert-info">
                            <h5>Welcome! I'm your Travel Assistant 👋</h5>
                            <p>I can help you with:</p>
                            <ul>
                                <li>Finding locations you've visited</li>
                                <li>Searching by state or date range</li>
                                <li>Getting travel statistics</li>
                                <li>Information about national parks</li>
                                <li>Available location types</li>
                            </ul>
                            <p class="mb-0"><strong>Try asking:</strong> "What locations have I visited in California?" or "How many states have I visited?"</p>
                        </div>
                    }

                    @foreach (var msg in messages)
                    {
                        <div class="mb-3 @(msg.IsUser ? "text-end" : "text-start")">
                            <div class="d-inline-block p-3 rounded @(msg.IsUser ? "chat-message-user" : "chat-message-assistant")"
                                 style="max-width: 75%;">
                                <div class="small mb-1">
                                    <strong>@(msg.IsUser ? "You" : "Assistant")</strong>
                                    <span class="text-muted ms-2">@msg.Timestamp.ToLocalTime().ToString("h:mm tt")</span>
                                </div>
                                <div style="white-space: pre-wrap;">@msg.Content</div>
                            </div>
                        </div>
                    }

                    @if (isLoading)
                    {
                        <div class="text-start mb-3">
                            <div class="d-inline-block p-3 rounded loading-indicator">
                                <div class="spinner-border spinner-border-sm me-2" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <span>Assistant is thinking...</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-3">
        <div class="col-md-12">
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       placeholder="Type your message here..."
                       @bind="currentMessage"
                       @onkeypress="HandleKeyPress"
                       disabled="@(isLoading || !Readiness.IsReady)" />
                <button class="btn btn-primary"
                        @onclick="SendMessage"
                        disabled="@(isLoading || !Readiness.IsReady || string.IsNullOrWhiteSpace(currentMessage))">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    }
                    else
                    {
                        <span class="bi bi-send-fill me-1"></span>
                    }
                    Send
                </button>
            </div>
            @if (!string.IsNullOrEmpty(currentThreadId))
            {
                <div class="form-text text-muted mt-1">Thread: @currentThreadId (Latest: @latestMessageDate?.ToLocalTime().ToString("MM/dd/yyyy HH:mm:ss"))</div>
            }
        </div>
    </div>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ChatMessage> messages = new();
    private string currentMessage = string.Empty;
    private bool isLoading = false;
    private string? currentThreadId = null;
    private DateTimeOffset? latestMessageDate = null;

    private class ChatMessage
    {
        public string Content { get; set; } = string.Empty;
        public bool IsUser { get; set; }
        public DateTime Timestamp { get; set; }
    }

    private async Task<ClaimsPrincipal?> GetPrincipalAsync()
    {
        if (AuthenticationStateTask is null) { return null; }
        var authenticationState = await AuthenticationStateTask;
        return authenticationState.User;
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(currentMessage) && !isLoading)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isLoading)
            return;

        if (!Readiness.IsReady)
        {
            // Failure entries are configuration key names only; they are logged, never rendered.
            Logger.LogWarning(
                "Travel assistant is not configured; missing configuration: {MissingConfigurationKeys}",
                string.Join(", ", Readiness.Failures));
            currentMessage = string.Empty;
            messages.Add(new ChatMessage
            {
                Content = "The travel assistant is not configured.",
                IsUser = false,
                Timestamp = DateTime.UtcNow
            });
            return;
        }

        var userMessage = currentMessage.Trim();
        currentMessage = string.Empty;

        messages.Add(new ChatMessage
        {
            Content = userMessage,
            IsUser = true,
            Timestamp = DateTime.UtcNow
        });

        isLoading = true;

        // Force UI update immediately to show loading state
        await InvokeAsync(StateHasChanged);
        await Task.Delay(1); // Small delay to ensure UI updates

        try
        {
            var principal = await GetPrincipalAsync();
            var userContext = await CurrentUserResolver.ResolveAsync(principal);

            if (userContext is null)
            {
                messages.Add(new ChatMessage
                {
                    Content = "You need to be signed in to use the travel assistant.",
                    IsUser = false,
                    Timestamp = DateTime.UtcNow
                });
                return;
            }

            var result = await ChatbotService.GetChatResponseAsync(userMessage, userContext.UserId, currentThreadId, latestMessageDate);

            latestMessageDate = result.LatestMessageDate;
            currentThreadId = result.ThreadId;

            messages.Add(new ChatMessage
            {
                Content = result.Message,
                IsUser = false,
                Timestamp = result.LatestMessageDate?.UtcDateTime ?? DateTime.UtcNow
            });
        }
        catch (Exception)
        {
            messages.Add(new ChatMessage
            {
                Content = "Something went wrong processing your message. Please try again later.",
                IsUser = false,
                Timestamp = DateTime.UtcNow
            });
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToBottom", "chatMessages");
        }
        catch (Exception)
        {
            // Ignore JS interop errors
        }
    }
}
