@using TravelTracker.Services
@inherits LayoutComponentBase
@inject IBuildInfoService BuildInfoService

<NavigationSpinner @ref="navigationSpinner" />

<div class="page">
    <NavMenu OnNavigating="HandleNavigating" />

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>

    <footer class="footer">
        <div class="container-fluid">
            <div class="footer-content">
                <span class="text-muted">Copyright @DateTime.Now.Year Luppes Consulting, Inc.</span>
                <div class="build-info">
                  <span class="build-number" title="@FormatBuildDate()">@FormatBuildNumber()</span>
                </div>
            </div>
        </div>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private NavigationSpinner? navigationSpinner;
    private BuildInfo? buildInfo;

    protected override async Task OnInitializedAsync()
    {
        buildInfo = BuildInfoService != null ? await BuildInfoService.GetBuildInfoAsync() : null;
    }

    private string FormatBuildDate()
    {
        if (buildInfo != null)
        {
            if (DateTime.TryParse(buildInfo.BuildDate, out var date))
            {
                return $"Compiled {date.ToString("yyyy-MM-dd HH:mm:ss")}";
            }
        }
        return "Unknown Date";
    }
    private string FormatBuildNumber()
    {
        return buildInfo != null ? buildInfo.BuildNumber : "Unknown";
    }
    private void HandleNavigating()
    {
        navigationSpinner?.StartNavigation();
    }
}
